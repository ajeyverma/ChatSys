{
  "name": "chatsys",
  "version": "2.1.0",
  "description": "Fault-Tolerant GUI-Based LAN Communication System with Automatic Failover",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:x64": "electron-builder --win --x64 --dir",
    "build:x86": "electron-builder --win --ia32 --dir",
    "build:arm64": "electron-builder --win --arm64 --dir"
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.chatsys.app",
    "productName": "ChatSys",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "dist"
    }
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "png-to-ico": "^3.0.1"
  }
}